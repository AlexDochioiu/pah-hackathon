# LiveKit Cloud project (fill with `lk app env -w -d .env`, or copy from the project's Settings > API keys).
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Stage server: robot/stage.py on the station, or `python3 fake_stage.py` here.
STAGE_URL=http://127.0.0.1:8770

# Optional overrides (defaults live at the top of storyteller.py).
# LLM_MODEL=google/gemma-4-31b-it
# TTS_MODEL=fishaudio/s2.1-pro
# STORY_VOICE=72324f5951924b2eb27faaf5630153b4  # story mode's narrator ("David - British Storyteller")
# HOST_VOICE=d657aa381ad444e393d7f6ff0f8cc2f0   # show mode's host, Lars ("Deadpool better"), the show's only voice
# STT_MODEL=assemblyai/universal-3-6-pro
# EXPRESSIVE=1
# CHARACTER_VOICES=1   # 0: the narrator reads the characters' lines too (voices.py)
# IDLE_AFTER_S=1.5
# NEXT_SCENE_AFTER_S=0.8
# SFX_SYNC_MS=0   # added to every sound timed to a gesture's hit (the arm and the room audio lag); tune by ear
# STORY_WRAP_S=105   # a story or comedy set past this is asked to wrap up; STORY_END_S=150 to end now
# SHOW_AUTO_GAP_S=1.5  # show auto-advance: the pause after an act's last gesture before the next act

# Sound levels and budget (kb/storyteller.md "Sound effects and music")
# SFX_VOLUME=0.2      # sfx gain: 12 dB under the old 0.8, on files levelled to -18 LUFS
# SFX_MIN_GAP_S=12    # at most one sfx per this many seconds in stories (gesture sounds count); 0 = no budget
# SFX_BUFFER_MS=150   # the sound track's send queue (LiveKit's default 400 put sfx ~0.4 s late)

# Gesture sync (kb/storyteller.md "How gestures sync to speech"); the logs' "sync" lines show the error per gesture
# GESTURE_LEAD=1      # 0: tags fire at their sentence's start (the old behaviour)
# AUDIO_DELAY_MS=250  # the listener's voice playout delay until the page reports its measured one
# ARM_LAG_MS=70       # the real arm trails its commanded pose
# HIT_DEFAULT_S=0.6   # a gesture without hit marks peaks this far in
# SENTENCE_HIT_S=0.5  # a tag for a whole sentence lands this far into it
# SPEECH_RATE=2.8     # syllables/s until measured live (the host voice: ~2.5)
# HIT_GAP_MS=200      # one arm's next gesture waits for its previous hit plus this
# FILL_GESTURES=1     # a motionless sentence gets a light move (look, nod)

# Gesture speed for stories (1.0 = full; the stage caps each gesture at its max_speed). Start slow on new hardware.
# STAGE_SPEED=0.7
